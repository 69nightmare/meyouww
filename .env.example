# Edge Function secrets. Set them on the hosted project with:
#   supabase secrets set --env-file supabase/.env
# Copy this file to supabase/.env (git-ignored). Never commit real values.

# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON on one line.
FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}

# Optional: only if your project does not already expose SUPABASE_SECRET_KEYS to functions.
# Supabase dashboard → Project settings → API keys → Secret keys.
# MEYOUWW_SECRET_KEY=sb_secret_xxxxxxxx
