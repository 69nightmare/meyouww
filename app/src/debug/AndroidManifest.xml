<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: a design preview that CI opens to screenshot screens that
     otherwise need a signed-in account (the chat). Not in release or GitHub builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <activity
            android:name=".DesignPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.Meyouww"
            tools:ignore="ExportedActivity" />
    </application>
</manifest>
