<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Meyouww" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night_background</item>
    </style>

    <style name="Theme.Meyouww.Splash" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/night_background</item>
