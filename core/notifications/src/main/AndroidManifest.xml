<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Normal permission, granted at install: lets friends' wallpapers be applied. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <application>
        <service
            android:name=".push.MeyouwwMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Reply / Mark as read on message notifications. -->
        <receiver
            android:name=".chat.ChatActionReceiver"
            android:exported="false" />

        <!-- Accept / Not now buttons on inbox notifications. Not exported: only our own
             PendingIntents can reach it. -->
        <receiver
            android:name=".push.ActivityActionReceiver"
            android:exported="false" />
        <!-- Undo / Pause on "X decorated your phone" notifications. -->
        <receiver
            android:name=".push.WallpaperActionReceiver"
            android:exported="false" />

        <!-- Used only if a message with a notification block ever arrives; ours are data-only. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_meyouww" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="delivery_status_v1" />
    </application>
</manifest>
